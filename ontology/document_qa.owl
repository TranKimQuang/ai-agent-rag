    <rdfs:domain rdf:resource="https://example.org/document-qa#Result"/>
    <rdfs:range rdf:resource="https://example.org/document-qa#Chunk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#Section">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#DocumentQAOntology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Document QA ontology</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#Result">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
