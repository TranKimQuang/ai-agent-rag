  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#QuestionAnswering">
    <rdf:type rdf:resource="https://example.org/document-qa#Task"/>
    <skos:prefLabel xml:lang="en">question answering</skos:prefLabel>
    <skos:altLabel xml:lang="en">QA</skos:altLabel>
    <skos:altLabel xml:lang="vi">hỏi đáp</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/document-qa#NaturalLanguageProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#Citation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#chunkText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/document-qa#Chunk"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#ResearchTopic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
