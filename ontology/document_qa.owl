   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://example.org/document-qa#Dataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://example.org/document-qa#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#pageNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/document-qa#Chunk"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#InformationRetrieval">
    <rdf:type rdf:resource="https://example.org/document-qa#ResearchTopic"/>
    <skos:prefLabel xml:lang="en">information retrieval</skos:prefLabel>
    <skos:altLabel xml:lang="en">IR</skos:altLabel>
    <skos:altLabel xml:lang="vi">truy hồi thông tin</skos:altLabel>
    <skos:narrower rdf:resource="https://example.org/document-qa#KeywordSearch"/>
    <skos:narrower rdf:resource="https://example.org/document-qa#SemanticSearch"/>
    <skos:narrower rdf:resource="https://example.org/document-qa#HybridSearch"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#SemanticSearch">
    <rdf:type rdf:resource="https://example.org/document-qa#Method"/>
    <skos:prefLabel xml:lang="en">semantic search</skos:prefLabel>
    <skos:altLabel xml:lang="vi">tìm kiếm ngữ nghĩa</skos:altLabel>
    <skos:altLabel xml:lang="en">dense retrieval</skos:altLabel>
    <qa:relatedTo rdf:resource="https://example.org/document-qa#InformationRetrieval"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#solvesTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/document-qa#Method"/>
    <rdfs:range rdf:resource="https://example.org/document-qa#Task"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#sourceFile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/document-qa#Document"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#mentionsConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/document-qa#Chunk"/>
    <rdfs:range rdf:resource="https://example.org/document-qa#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#RetrievalAugmentedGeneration">
    <rdf:type rdf:resource="https://example.org/document-qa#Method"/>
    <skos:prefLabel xml:lang="en">retrieval augmented generation</skos:prefLabel>
    <skos:altLabel xml:lang="en">RAG</skos:altLabel>
    <skos:altLabel xml:lang="en">retrieval-augmented generation</skos:altLabel>
    <qa:solvesTask rdf:resource="https://example.org/document-qa#QuestionAnswering"/>
    <qa:relatedTo rdf:resource="https://example.org/document-qa#InformationRetrieval"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#SampleChunk">
    <rdf:type rdf:resource="https://example.org/document-qa#Chunk"/>
    <qa:pageNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</qa:pageNumber>
    <qa:chunkText>RAG retrieves evidence before generating an answer.</qa:chunkText>
    <qa:mentionsConcept rdf:resource="https://example.org/document-qa#RetrievalAugmentedGeneration"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#ReciprocalRankFusion">
    <rdf:type rdf:resource="https://example.org/document-qa#Method"/>
    <skos:prefLabel xml:lang="en">reciprocal rank fusion</skos:prefLabel>
    <skos:altLabel xml:lang="en">RRF</skos:altLabel>
    <qa:relatedTo rdf:resource="https://example.org/document-qa#HybridSearch"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#EvidenceF1">
    <rdf:type rdf:resource="https://example.org/document-qa#Metric"/>
    <skos:prefLabel xml:lang="en">evidence F1</skos:prefLabel>
    <skos:altLabel xml:lang="en">Evidence F1 score</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#Task">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://example.org/document-qa#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#usesMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/document-qa#Paper"/>
    <rdfs:range rdf:resource="https://example.org/document-qa#Method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#Chunk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#HybridSearch">
    <rdf:type rdf:resource="https://example.org/document-qa#Method"/>
    <skos:prefLabel xml:lang="en">hybrid search</skos:prefLabel>
    <skos:altLabel xml:lang="vi">tìm kiếm kết hợp</skos:altLabel>
    <skos:altLabel xml:lang="en">hybrid retrieval</skos:altLabel>
    <qa:relatedTo rdf:resource="https://example.org/document-qa#KeywordSearch"/>
    <qa:relatedTo rdf:resource="https://example.org/document-qa#SemanticSearch"/>
    <qa:relatedTo rdf:resource="https://example.org/document-qa#ReciprocalRankFusion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#hasSection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/document-qa#Document"/>
    <rdfs:range rdf:resource="https://example.org/document-qa#Section"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#NaturalLanguageProcessing">
    <rdf:type rdf:resource="https://example.org/document-qa#ResearchTopic"/>
    <skos:prefLabel xml:lang="en">natural language processing</skos:prefLabel>
    <skos:altLabel xml:lang="en">NLP</skos:altLabel>
    <skos:altLabel xml:lang="vi">xử lý ngôn ngữ tự nhiên</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#evaluatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/document-qa#Paper"/>
    <rdfs:range rdf:resource="https://example.org/document-qa#Metric"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#relatedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:domain rdf:resource="https://example.org/document-qa#Concept"/>
    <rdfs:range rdf:resource="https://example.org/document-qa#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#SamplePaper">
    <rdf:type rdf:resource="https://example.org/document-qa#Paper"/>
    <qa:title>A sample paper about retrieval-augmented generation</qa:title>
    <qa:hasSection rdf:resource="https://example.org/document-qa#MethodsSection"/>
    <qa:usesMethod rdf:resource="https://example.org/document-qa#RetrievalAugmentedGeneration"/>
    <qa:usesDataset rdf:resource="https://example.org/document-qa#QASPER"/>
    <qa:evaluatedBy rdf:resource="https://example.org/document-qa#EvidenceF1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#QASPER">
    <rdf:type rdf:resource="https://example.org/document-qa#Dataset"/>
    <skos:prefLabel xml:lang="en">QASPER</skos:prefLabel>
    <skos:altLabel xml:lang="en">QASPER dataset</skos:altLabel>
    <qa:relatedTo rdf:resource="https://example.org/document-qa#QuestionAnswering"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/document-qa#hasChunk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/document-qa#Section"/>
